{
  "name": "inmypoket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-local-bin.mjs next next dev",
    "dev:3001": "node scripts/run-powershell-script.mjs ./scripts/run-next-with-port.ps1 -Mode dev -Port 3001",
    "build": "node scripts/run-local-bin.mjs next next build",
    "start": "node scripts/run-local-bin.mjs next next start",
    "start:3001": "node scripts/run-powershell-script.mjs ./scripts/run-next-with-port.ps1 -Mode start -Port 3001",
    "start:3109": "node scripts/run-powershell-script.mjs ./scripts/run-next-with-port.ps1 -Mode start -Port 3109",
    "port:check": "node scripts/run-powershell-script.mjs ./scripts/check-port.ps1 -Port 3000",
    "boundary:check": "node scripts/check-boundaries.mjs",
    "secret:check": "node scripts/check-secrets.mjs",
    "lint": "node scripts/run-local-bin.mjs eslint eslint . --max-warnings=0",
    "typecheck": "node scripts/run-local-bin.mjs next next typegen && node scripts/run-local-bin.mjs typescript tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/normalization.test.ts tests/operator-observation-queue.test.ts tests/location-context-lane-a.test.ts tests/waitlist-lane-a.test.ts tests/waitlist-harness-lane-a.test.ts tests/publication-governance-lane-a.test.ts tests/governance-seed-30328-contract.test.ts tests/hosted-proof-observation.test.ts tests/release-health-freshness.test.ts tests/hosted-proof-request.test.ts tests/admin-evidence-download-route.test.ts tests/source-quality.test.ts tests/ops-boundary-scripts.test.ts tests/secret-scan.test.ts",
    "import:legacy": "node --experimental-strip-types scripts/import-legacy-json.ts",
    "smoke:public": "node scripts/run-powershell-script.mjs ./scripts/public-smoke.ps1",
    "smoke:public:3109": "node scripts/run-powershell-script.mjs ./scripts/public-smoke.ps1 -BaseUrl http://localhost:3109",
    "smoke:local": "node scripts/run-powershell-script.mjs ./scripts/live-smoke.ps1",
    "ops:evidence": "node scripts/run-powershell-script.mjs ./scripts/collect-ops-evidence.ps1",
    "ops:ui-evidence": "node scripts/run-powershell-script.mjs ./scripts/capture-ui-evidence.ps1",
    "ops:verify": "node --experimental-strip-types scripts/verify-ops-evidence.ts",
    "ops:local-preflight": "pnpm boundary:check && pnpm secret:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "ops:harden-published-view": "node scripts/run-powershell-script.mjs ./scripts/harden-published-view-direct-grants.ps1",
    "ops:harden-published-view:apply": "node scripts/run-powershell-script.mjs ./scripts/harden-published-view-direct-grants.ps1 -Apply -Verify",
    "ops:harden-published-view:status": "node scripts/run-powershell-script.mjs ./scripts/harden-published-view-direct-grants.ps1 -Status",
    "ops:harden-published-view:verify": "node scripts/run-powershell-script.mjs ./scripts/harden-published-view-direct-grants.ps1 -VerifyOnly",
    "ops:attest-hosted": "node --experimental-strip-types scripts/write-hosted-attestation.ts",
    "ops:handoff": "node --experimental-strip-types scripts/show-external-proof-handoff.ts",
    "ops:show-hardening": "node --experimental-strip-types scripts/show-hardening-handoff.ts",
    "ops:show-supabase-sql": "node --experimental-strip-types scripts/show-supabase-sql-handoff.ts",
    "ops:observe-hosted-proof": "node --experimental-strip-types scripts/observe-hosted-proof.ts",
    "ops:show-hosted-proof": "node --experimental-strip-types scripts/show-hosted-proof-observation.ts",
    "ops:show-hosted-proof-request": "node --experimental-strip-types scripts/show-hosted-proof-request.ts",
    "visual:update-baseline": "node scripts/run-powershell-script.mjs ./scripts/update-visual-baseline.ps1",
    "visual:check": "node scripts/run-python-script.mjs ./scripts/verify-visual-baseline.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^9.39.1",
    "eslint-config-next": "latest",
    "typescript": "latest"
  }
}
